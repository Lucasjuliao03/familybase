{
  "name": "familybase-mobile",
  "version": "1.0.5",
  "main": "expo-router/entry",
  "type": "module",
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/metro-runtime": "~56.0.19",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.49.4",
    "babel-preset-expo": "^56.0.12",
    "expo": "~56.0.23",
    "expo-constants": "~56.0.15",
    "expo-dev-client": "~56.0.27",
    "expo-font": "~56.0.5",
    "expo-image-picker": "~56.0.25",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.18",
    "expo-local-authentication": "~56.0.4",
    "expo-location": "~56.0.26",
    "expo-router": "~56.2.21",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.27",
    "expo-video": "~56.1.4",
    "leaflet": "^1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "^0.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "expo-build-properties": "~56.0.27",
    "expo-dev-client": "~56.0.27",
    "expo-doctor": "^1.20.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "eas-build-post-install": "npm run sync:avatars && npm run sync:map && npm run typecheck",
    "test": "node --experimental-strip-types --test src/lib/__tests__/**/*.test.*",
    "sync:avatars": "node scripts/syncAvatarCatalog.cjs",
    "sync:map": "node scripts/syncLeafletAssets.cjs",
    "prestart": "npm run sync:avatars && npm run sync:map",
    "start": "expo start",
    "tunnel": "expo start --tunnel",
    "preandroid": "npm run sync:avatars && npm run sync:map",
    "android": "expo run:android",
    "preios": "npm run sync:avatars && npm run sync:map",
    "ios": "expo run:ios",
    "preweb": "npm run sync:avatars && npm run sync:map",
    "web": "expo start --web",
    "prebuild:eas:android:dev": "expo prebuild --platform android",
    "build:eas:android:dev": "eas build --platform android --profile development --clear-cache",
    "build:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "build:apk:debug": "cd android && gradlew.bat assembleDebug",
    "build:apk:eas": "eas build --platform android --profile preview",
    "build:apk:eas:local": "eas build --platform android --profile preview --local"
  },
  "private": true,
  "allowScripts": {
    "msgpackr-extract@3.0.3": true
  }
}
